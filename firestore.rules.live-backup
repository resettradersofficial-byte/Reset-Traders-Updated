rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).role == "admin";
    }

    function hasCourseAccess() {
      return isAdmin()
        || (
          signedIn()
          && hasUser(request.auth.uid)
          && userData(request.auth.uid).role == "student"
          && userData(request.auth.uid).access.active == true
          && (
            userData(request.auth.uid).access.get("expiresAt", null) == null
            || userData(request.auth.uid).access.expiresAt > request.time
          )
        );
    }

    function validInactiveSelfProfile(uid) {
      return isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.access.active == false
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "role", "access", "createdAt", "updatedAt"
        ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isAdmin() || validInactiveSelfProfile(uid);
      allow update: if isAdmin()
        || (
          isSelf(uid)
          && resource.data.role == "student"
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.access == resource.data.access
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["name", "updatedAt"])
        );
      allow delete: if isAdmin();

      match /progress/{lessonId} {
        allow read: if isAdmin() || (isSelf(uid) && hasCourseAccess());
        allow create, update: if isSelf(uid)
          && hasCourseAccess()
          && request.resource.data.lessonId == lessonId
          && request.resource.data.keys().hasOnly(["lessonId", "completed", "completedAt"]);
        allow delete: if isAdmin() || isSelf(uid);
      }
    }

    match /sessions/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "sessionId", "email", "userAgent", "updatedAt", "signedOutAt"
        ]);
      allow delete: if isAdmin() || isSelf(uid);
    }

    match /lessons/{lessonId} {
      allow read: if hasCourseAccess();
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site/{documentId} {
      allow read: if documentId == "public";
      allow create, update, delete: if isAdmin();
    }

    match /doubts/{doubtId} {
      allow create: if hasCourseAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "uid", "studentEmail", "studentName", "lessonId", "lessonTitle", "text", "createdAt"
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "reply", "repliedAt", "repliedBy"
        ]);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
