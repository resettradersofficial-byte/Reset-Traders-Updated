rules_version = '2';

// Reset Traders Firestore rules.
// Based on the rules deployed 2026-06-19 (backup: firestore.rules.live-backup).
// The payment Worker writes users/orders/payments/webhookEvents with a service account,
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).role == "admin";
    }

    function hasCourseAccess() {
      return isAdmin()
        || (
          signedIn()
          && hasUser(request.auth.uid)
          && userData(request.auth.uid).role == "student"
          && userData(request.auth.uid).access.active == true
          && (
            userData(request.auth.uid).access.get("expiresAt", null) == null
            || userData(request.auth.uid).access.expiresAt > request.time
          )
        );
    }

    function validInactiveSelfProfile(uid) {
      return isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.access == {"active": false, "source": "checkout_started"}
        && request.resource.data.get("name", "") is string
        && request.resource.data.get("name", "").size() <= 120
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "role", "access", "createdAt", "updatedAt"
        ]);
    }

    // A student whose access was switched off (e.g. revoked by an admin) may restart
    // checkout: only access.source may change, to "checkout_started", and access stays inactive.
    function accessUnchangedOrCheckoutRestart() {
      return request.resource.data.access == resource.data.access
        || (
          resource.data.access.get("active", false) != true
          && request.resource.data.access.active == false
          && request.resource.data.access.source == "checkout_started"
          && request.resource.data.access.diff(resource.data.access).affectedKeys().hasOnly(["active", "source"])
        );
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isAdmin() || validInactiveSelfProfile(uid);
      allow update: if isAdmin()
        || (
          isSelf(uid)
          && resource.data.role == "student"
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && accessUnchangedOrCheckoutRestart()
          // affectedKeys (not changedKeys) so a student cannot ADD fields such as plan or Pro flags
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt", "access", "createdAt"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt"]) || !("createdAt" in resource.data))
          && request.resource.data.get("name", "") is string
          && request.resource.data.get("name", "").size() <= 120
        );
      allow delete: if isAdmin();

      match /progress/{lessonId} {
        allow read: if isAdmin() || (isSelf(uid) && hasCourseAccess());
        allow create, update: if isSelf(uid)
          && hasCourseAccess()
          && request.resource.data.lessonId == lessonId
          && request.resource.data.keys().hasOnly(["lessonId", "completed", "completedAt"]);
        allow delete: if isAdmin() || isSelf(uid);
      }
    }

    match /sessions/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get("sessionId", "") is string
        && request.resource.data.get("sessionId", "").size() <= 64
        && request.resource.data.get("userAgent", "") is string
        && request.resource.data.get("userAgent", "").size() <= 240
        && request.resource.data.keys().hasOnly([
          "uid", "sessionId", "email", "userAgent", "updatedAt", "signedOutAt"
        ]);
      allow delete: if isAdmin() || isSelf(uid);
    }

    match /lessons/{lessonId} {
      allow read: if hasCourseAccess();
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site/{documentId} {
      allow read: if documentId == "public";
      allow create, update, delete: if isAdmin();
    }

    match /doubts/{doubtId} {
      allow create: if hasCourseAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid", "studentEmail", "studentName", "lessonId", "lessonTitle", "text", "createdAt"
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "reply", "repliedAt", "repliedBy"
        ]);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reset Audit leads: public create-only, every field checked. Admins read/delete.
    function validPct(p) {
      return p is map
        && p.keys().hasOnly(["R", "P", "C", "I"])
        && p.keys().hasAll(["R", "P", "C", "I"])
        && p.R is int && p.R >= 0 && p.R <= 100
        && p.P is int && p.P >= 0 && p.P <= 100
        && p.C is int && p.C >= 0 && p.C <= 100
        && p.I is int && p.I >= 0 && p.I <= 100;
    }

    function validAuditLead(d) {
      return d.keys().hasOnly(["email", "type", "pct", "body", "nerve", "stage", "rule", "isRetake", "source", "createdAt", "ref"])
        && d.keys().hasAll(["email", "type", "pct", "body", "nerve", "stage", "rule", "isRetake", "source", "createdAt"])
        && d.email is string
        && d.email.size() <= 254
        && d.email.matches("^[^\\s@A-Z]+@[^\\s@A-Z]+\\.[^\\s@A-Z]{2,}$")
        && d.type in ["Rusher", "Performer", "Competitor", "Intellectualizer"]
        && validPct(d.pct)
        && d.body in ["jaw", "chest", "stomach", "neck", "none"]
        && d.nerve in ["fight", "flight", "freeze", "fawn"]
        && d.stage in ["first", "f12", "f3", "funded", "steady"]
        && d.rule is string && d.rule.size() <= 400
        && d.isRetake is bool
        && d.source in ["audit", "test"]
        // optional: where the visitor came from (?ref=)
        && (!("ref" in d) || d.ref in ["dm", "bio", "story", "reel"])
        && d.createdAt == request.time;
    }

    match /auditLeads/{leadId} {
      allow create: if validAuditLead(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
