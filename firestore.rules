rules_version = '2';

// Reset Traders Firestore rules.
// Based on the rules deployed 2026-06-19 (backup: firestore.rules.live-backup).
// The payment Worker writes users/orders/payments/webhookEvents with a service account,
// which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUser(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && hasUser(request.auth.uid)
        && userData(request.auth.uid).role == "admin";
    }

    function hasCourseAccess() {
      return isAdmin()
        || (
          signedIn()
          && hasUser(request.auth.uid)
          && userData(request.auth.uid).role == "student"
          && userData(request.auth.uid).access.active == true
          && (
            userData(request.auth.uid).access.get("expiresAt", null) == null
            || userData(request.auth.uid).access.expiresAt > request.time
          )
        );
    }

    function validInactiveSelfProfile(uid) {
      return isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student"
        && request.resource.data.access == {"active": false, "source": "checkout_started"}
        && request.resource.data.get("name", "") is string
        && request.resource.data.get("name", "").size() <= 120
        && request.resource.data.keys().hasOnly([
          "uid", "email", "name", "role", "access", "createdAt", "updatedAt"
        ]);
    }

    // A student whose access was switched off (e.g. revoked by an admin) may restart
    // checkout: only access.source may change, to "checkout_started", and access stays inactive.
    function accessUnchangedOrCheckoutRestart() {
      return request.resource.data.access == resource.data.access
        || (
          resource.data.access.get("active", false) != true
          && request.resource.data.access.active == false
          && request.resource.data.access.source == "checkout_started"
          && request.resource.data.access.diff(resource.data.access).affectedKeys().hasOnly(["active", "source"])
        );
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isAdmin() || validInactiveSelfProfile(uid);
      allow update: if isAdmin()
        || (
          isSelf(uid)
          && resource.data.role == "student"
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && accessUnchangedOrCheckoutRestart()
          // affectedKeys (not changedKeys) so a student cannot ADD fields such as plan or Pro flags
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt", "access", "createdAt"])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["createdAt"]) || !("createdAt" in resource.data))
          && request.resource.data.get("name", "") is string
          && request.resource.data.get("name", "").size() <= 120
        );
      allow delete: if isAdmin();

      match /progress/{lessonId} {
        allow read: if isAdmin() || (isSelf(uid) && hasCourseAccess());
        allow create, update: if isSelf(uid)
          && hasCourseAccess()
          && request.resource.data.lessonId == lessonId
          && request.resource.data.keys().hasOnly(["lessonId", "completed", "completedAt"]);
        allow delete: if isAdmin() || isSelf(uid);
      }
    }

    match /sessions/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get("sessionId", "") is string
        && request.resource.data.get("sessionId", "").size() <= 64
        && request.resource.data.get("userAgent", "") is string
        && request.resource.data.get("userAgent", "").size() <= 240
        && request.resource.data.keys().hasOnly([
          "uid", "sessionId", "email", "userAgent", "updatedAt", "signedOutAt"
        ]);
      allow delete: if isAdmin() || isSelf(uid);
    }

    match /lessons/{lessonId} {
      allow read: if hasCourseAccess();
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site/{documentId} {
      allow read: if documentId == "public";
      allow create, update, delete: if isAdmin();
    }

    match /doubts/{doubtId} {
      allow create: if hasCourseAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "uid", "studentEmail", "studentName", "lessonId", "lessonTitle", "text", "createdAt"
        ]);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "reply", "repliedAt", "repliedBy"
        ]);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reset Audit leads: public create-only, every field checked. Admins read/delete.
    function validPct(p) {
      return p is map
        && p.keys().hasOnly(["R", "P", "C", "I"])
        && p.keys().hasAll(["R", "P", "C", "I"])
        && p.R is int && p.R >= 0 && p.R <= 100
        && p.P is int && p.P >= 0 && p.P <= 100
        && p.C is int && p.C >= 0 && p.C <= 100
        && p.I is int && p.I >= 0 && p.I <= 100;
    }

    function validAuditLead(d) {
      return d.keys().hasOnly(["email", "type", "pct", "body", "nerve", "stage", "rule", "isRetake", "source", "createdAt", "ref", "level", "root", "leads", "patterns"])
        && d.keys().hasAll(["email", "type", "pct", "body", "nerve", "stage", "rule", "isRetake", "source", "createdAt"])
        && d.email is string
        && d.email.size() <= 254
        && d.email.matches("^[^\\s@A-Z]+@[^\\s@A-Z]+\\.[^\\s@A-Z]{2,}$")
        && d.type in ["Rusher", "Performer", "Competitor", "Intellectualizer"]
        && validPct(d.pct)
        && d.body in ["jaw", "chest", "stomach", "neck", "none"]
        && d.nerve in ["fight", "flight", "freeze", "fawn"]
        && d.stage in ["first", "f12", "f3", "funded", "steady"]
        && d.rule is string && d.rule.size() <= 400
        && d.isRetake is bool
        && d.source in ["audit", "test"]
        // optional: where the visitor came from (?ref=)
        && (!("ref" in d) || d.ref in ["dm", "bio", "story", "reel", "site"])
        // optional (older cached pages don't send them): result level and the type from the sting question
        && (!("level" in d) || d.level in ["steady", "mixed", "strong"])
        && (!("root" in d) || d.root in ["Rusher", "Performer", "Competitor", "Intellectualizer"])
        // optional: tied lead hijacks (blend/split) and where the hijacks showed up
        && (!("leads" in d) || (d.leads is list && d.leads.size() <= 4
              && d.leads.hasOnly(["Rusher", "Performer", "Competitor", "Intellectualizer"])
              && d.leads.toSet().size() == d.leads.size()))
        && (!("patterns" in d) || (d.patterns is list && d.patterns.size() <= 5
              && d.patterns.hasOnly(["loss", "win", "both", "fomo", "social"])
              && d.patterns.toSet().size() == d.patterns.size()))
        && d.createdAt == request.time;
    }

    match /auditLeads/{leadId} {
      allow create: if validAuditLead(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Founding-seat reservations from the audit's offer page: public create-only, every field checked.
    // product: "reset" = Your Personal Reset, "journal" = Journal Pro (the skip-the-course offer).
    // source: "audit" = the audit offer page, "journal" = the course card inside Journal Pro.
    function validReservation(d) {
      return d.keys().hasOnly(["email", "product", "type", "region", "source", "createdAt"])
        && d.keys().hasAll(["email", "product", "type", "region", "source", "createdAt"])
        && d.email is string
        && d.email.size() <= 254
        && d.email.matches("^[^\\s@A-Z]+@[^\\s@A-Z]+\\.[^\\s@A-Z]{2,}$")
        && d.product in ["reset", "journal"]
        && d.type in ["Rusher", "Performer", "Competitor", "Intellectualizer"]
        && d.region in ["in", "intl"]
        && d.source in ["audit", "journal", "test"]
        && d.createdAt == request.time;
    }

    match /reservations/{reservationId} {
      allow create: if validReservation(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Journal Pro (/journal/). Each trader owns journals/{uid} and its trades.
    // Admins can read the settings doc (email, hijack, last log: who joined and who is active),
    // never the trades. Entitlement lives in journalAccess/{uid}, written only by admins
    // (later the payment Worker, with its service account).
    function hijackName(v) {
      return v in ["Rusher", "Performer", "Competitor", "Intellectualizer"];
    }

    function validJournal(uid, d) {
      return d.keys().hasOnly(["uid", "email", "hijack", "currency", "hidePnl", "windowMin", "cooldownMin", "lossStop",
                               "createdAt", "updatedAt", "lastLogAt"])
        && d.keys().hasAll(["uid", "email", "hijack", "currency", "hidePnl", "windowMin", "createdAt", "updatedAt"])
        && d.uid == uid
        && d.email == request.auth.token.email
        && (hijackName(d.hijack) || d.hijack == "unsure")
        && d.currency in ["INR", "USD"]
        && d.hidePnl is bool
        && d.windowMin is int && d.windowMin >= 5 && d.windowMin <= 240
        // From the course's Contract: minutes off-screen after any loss, and done for the day after N losses in a row.
        && (!("cooldownMin" in d) || (d.cooldownMin is int && d.cooldownMin >= 1 && d.cooldownMin <= 120))
        && (!("lossStop" in d) || (d.lossStop is int && d.lossStop >= 1 && d.lossStop <= 10))
        && d.updatedAt == request.time
        && (!("lastLogAt" in d) || d.lastLogAt is timestamp);
    }

    // kind "trade": a taken trade with its P&L (optional: size vs normal, whether the stop rule was used first).
    // kind "skip": a valid setup the trader let pass. kind "check": a pre-trade check and how it ended.
    function validTrade(d) {
      return d.keys().hasOnly(["kind", "at", "pnl", "planned", "hijack", "note", "size", "ruleUsed", "outcome", "createdAt", "updatedAt"])
        && d.keys().hasAll(["kind", "at", "hijack", "createdAt", "updatedAt"])
        && d.at is timestamp
        && d.at < request.time + duration.value(1, "d")
        && d.at > request.time - duration.value(3650, "d")
        && (hijackName(d.hijack) || d.hijack == "none")
        && (!("note" in d) || (d.note is string && d.note.size() <= 280))
        && d.updatedAt == request.time
        && (
          (d.kind == "trade"
            && d.keys().hasAll(["pnl", "planned"])
            && !("outcome" in d)
            && d.pnl is number && d.pnl > -1000000000 && d.pnl < 1000000000
            && d.planned is bool
            && (!("size" in d) || d.size in ["smaller", "same", "bigger"])
            && (!("ruleUsed" in d) || d.ruleUsed is bool))
          || (d.kind == "skip" && !d.keys().hasAny(["pnl", "planned", "size", "ruleUsed", "outcome"]))
          || (d.kind == "check"
            && !d.keys().hasAny(["pnl", "planned", "size", "ruleUsed"])
            && d.outcome in ["skip", "take"])
        );
    }

    match /journals/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && validJournal(uid, request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && validJournal(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid);

      match /trades/{tradeId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid)
          && validTrade(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isSelf(uid)
          && validTrade(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    match /journalAccess/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
